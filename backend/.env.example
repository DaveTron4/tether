# Backend Server Configuration
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tether_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# JWT/Authentication (if needed)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1h
JWT_HEADER_KEY=your_jwt_header_key_here

# Environment
NODE_ENV=development
ADMIN_PASSWORD=your_admin_password_here

# Super Admin Secret
SUPER_ADMIN_SECRET=your_super_admin_secret_here

# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Stripe Price IDs (from Stripe Dashboard → Products → Pricing)
STRIPE_PRICE_STARTER_MONTHLY=your_starter_monthly_price_id_here
STRIPE_PRICE_STARTER_YEARLY=your_starter_yearly_price_id_here
STRIPE_PRICE_PRO_MONTHLY=your_pro_monthly_price_id_here
STRIPE_PRICE_PRO_YEARLY=your_pro_yearly_price_id_here
STRIPE_PRICE_ENTERPRISE_MONTHLY=your_enterprise_monthly_price_id_here
STRIPE_PRICE_ENTERPRISE_YEARLY=your_enterprise_yearly_price_id_here

# Frontend Configuration
FRONTEND_URL=http://localhost:4200
